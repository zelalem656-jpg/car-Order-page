import React, { useState, useEffect } from 'react';
import { createClient } from '@supabase/supabase-js';

const SUPABASE_URL = 'https://aroossifftxwrmckyfdlv.supabase.co';
const SUPABASE_KEY = 'Sb_publishable_LFFfD_vYbQltG7UeynOxCg_lgvDTvyn';

const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

export default function App() {
  const [cars, setCars] = useState([]);
  const [isAdmin, setIsAdmin] = useState(false);
  const [newCar, setNewCar] = useState({ name: '', price: '', color: '', image: '', video_url: '' });

  useEffect(() => {
    fetchCars();
  }, []);

  const fetchCars = async () => {
    const { data } = await supabase.from('cars').select('*').order('id', { ascending: false });
    if (data) setCars(data);
  };

  const handleAddCar = async (e) => {
    e.preventDefault();
    if (!newCar.name || !newCar.price) return alert('እባክዎን ስም እና ዋጋ ያስገቡ');
    
    const { error } = await supabase.from('cars').insert([
      { ...newCar, price: parseFloat(newCar.price) }
    ]);

    if (!error) {
      alert('መኪናው በስኬት ተጨምሯል!');
      setNewCar({ name: '', price: '', color: '', image: '', video_url: '' });
      fetchCars();
    } else {
      alert('ስህተት ተፈጥሯል: ' + error.message);
    }
  };

  const handleDeleteCar = async (id) => {
    if (window.confirm('መኪናውን ማጥፋት እርግጠኛ ነዎት?')) {
      await supabase.from('cars').delete().eq('id', id);
      fetchCars();
    }
  };

  return (
    <div style={{ maxWidth: '1000px', margin: '0 auto', padding: '20px', fontFamily: 'sans-serif' }}>
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', borderBottom: '2px solid #ddd', paddingBottom: '10px' }}>
        <h2>🚗 East Africa Cars Catalog</h2>
        <button 
          onClick={() => setIsAdmin(!isAdmin)} 
          style={{ padding: '8px 15px', backgroundColor: '#333', color: '#fff', border: 'none', borderRadius: '5px', cursor: 'pointer' }}
        >
          {isAdmin ? 'ወደ ገዢዎች ገጽ' : 'Admin Panel'}
        </button>
      </div>

      {isAdmin ? (
        <div style={{ marginTop: '20px', padding: '20px', border: '1px solid #2563eb', borderRadius: '8px', backgroundColor: '#f0f9ff' }}>
          <h3>🔧 አድሚን ዳሽቦርድ - አዲስ መኪና መዝግብ</h3>
          <form onSubmit={handleAddCar} style={{ display: 'grid', gap: '10px', maxWidth: '500px' }}>
            <input placeholder="የመኪና ስም (ምሳሌ፡ Toyota RAV4)" value={newCar.name} onChange={e => setNewCar({...newCar, name: e.target.value})} style={{ padding: '8px' }} />
            <input type="number" placeholder="ዋጋ በ ብር (ምሳሌ፡ 4500000)" value={newCar.price} onChange={e => setNewCar({...newCar, price: e.target.value})} style={{ padding: '8px' }} />
            <input placeholder="ከለር" value={newCar.color} onChange={e => setNewCar({...newCar, color: e.target.value})} style={{ padding: '8px' }} />
            <input placeholder="የምስል (Image) Link URL" value={newCar.image} onChange={e => setNewCar({...newCar, image: e.target.value})} style={{ padding: '8px' }} />
            <input placeholder="የቪዲዮ (Video) Link URL" value={newCar.video_url} onChange={e => setNewCar({...newCar, video_url: e.target.value})} style={{ padding: '8px' }} />
            <button type="submit" style={{ padding: '10px', backgroundColor: '#16a34a', color: '#fff', border: 'none', borderRadius: '5px', fontWeight: 'bold' }}>+ መኪና መዝግብ</button>
          </form>

          <h4 style={{ marginTop: '30px' }}>የተመዘገቡ መኪኖች ማስተካከያ</h4>
          {cars.map(car => (
            <div key={car.id} style={{ display: 'flex', justifyContent: 'space-between', padding: '10px', borderBottom: '1px solid #ccc' }}>
              <span>{car.name} - {car.price?.toLocaleString()} ETB</span>
              <button onClick={() => handleDeleteCar(car.id)} style={{ backgroundColor: '#dc2626', color: '#fff', border: 'none', padding: '5px 10px', borderRadius: '3px' }}>አጥፋ</button>
            </div>
          ))}
        </div>
      ) : (
        <div style={{ marginTop: '20px' }}>
          <h3>የሚሸጡ መኪኖች ({cars.length})</h3>
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(280px, 1fr))', gap: '20px' }}>
            {cars.map(car => (
              <div key={car.id} style={{ border: '1px solid #eee', borderRadius: '10px', overflow: 'hidden', boxShadow: '0 2px 5px rgba(0,0,0,0.1)' }}>
                {car.image && <img src={car.image} alt={car.name} style={{ width: '100%', height: '180px', objectFit: 'cover' }} />}
                <div style={{ padding: '15px' }}>
                  <h4 style={{ margin: '0 0 10px 0' }}>{car.name}</h4>
                  <p style={{ margin: '5px 0', color: '#666' }}>ከለር፡ {car.color || 'ያልተገለፀ'}</p>
                  <p style={{ margin: '5px 0', fontSize: '18px', fontWeight: 'bold', color: '#2563eb' }}>{car.price?.toLocaleString()} ETB</p>
                  {car.video_url && (
                    <a href={car.video_url} target="_blank" rel="noreferrer" style={{ display: 'inline-block', marginTop: '5px', color: '#dc2626', fontSize: '14px' }}>
                      ▶ ቪዲዮ ይመልከቱ
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}
