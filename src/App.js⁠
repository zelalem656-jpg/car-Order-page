            </label>
            <select 
              className="w-full border border-gray-300 p-3 rounded-lg focus:ring-2 focus:ring-blue-500 mb-6 bg-white"
              value={selectedVehicle.id}
              onChange={(e) => {
                const vehicle = vehicles.find(v => v.id === parseInt(e.target.value));
                setSelectedVehicle(vehicle);
              }}
            >
              {vehicles.map((v) => (
                <option key={v.id} value={v.id}>
                  {v.name} - {v.price.toLocaleString()} ብር
                </option>
              ))}
            </select>

            {/* የዋጋ ስሌት */}
            <div className="bg-white p-4 rounded-xl border border-gray-200 space-y-3">
              <div className="flex justify-between text-gray-600">
                <span>ጠቅላላ ዋጋ፡</span>
                <span className="font-bold text-gray-800">{selectedVehicle.price.toLocaleString()} ብር</span>
              </div>
              <div className="flex justify-between text-gray-600">
