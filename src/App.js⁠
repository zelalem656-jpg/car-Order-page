                <option>CBE Direct Bank Transfer</option>
                <option>Awash Bank / Hibret Bank</option>
              </select>
            </div>

            <button type="submit" className="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-lg transition duration-200 mt-2">
